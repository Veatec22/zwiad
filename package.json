{
  "name": "zagieldev-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "py:lint": "uvx ruff check public",
    "py:lint:fix": "uvx ruff check public --fix",
    "py:format": "uvx ruff format public",
    "py:format:check": "uvx ruff format public --check",
    "py:test": "python -m pytest tests/mael/run_registry_test.py",
    "test": "vitest run",
    "test:all": "bun run test && bun run py:test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run py:lint && bun run py:format:check"
  },
